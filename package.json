{
  "name": "nope-ai",
  "version": "0.1.0",
  "description": "Open-source AI that calls companies so you don't have to. Cancel, negotiate, complain — hands free.",
  "author": "Guillaume Flambard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guillaume-flambard/nope"
  },
  "keywords": [
    "ai",
    "phone",
    "voice",
    "agent",
    "cancel",
    "negotiate",
    "subscription",
    "twilio",
    "openai",
    "open-source"
  ],
  "main": "dist/cli.js",
  "bin": {
    "nope": "dist/cli.js",
    "nope-ai": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bun run tsc && chmod +x dist/cli.js",
    "dev": "bun run src/cli.ts",
    "start": "bun run dist/cli.js",
    "server": "bun run src/web/server.ts",
    "simulate": "bun run src/cli.ts call --simulate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.7.0",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.4.0",
    "ora": "^9.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "twilio": "^6.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/guillaume-flambard/nope/issues"
  },
  "homepage": "https://github.com/guillaume-flambard/nope"
}
