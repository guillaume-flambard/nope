{
  "name": "nope-ai",
  "version": "0.1.0",
  "description": "Open-source AI that calls companies so you don't have to. Cancel, negotiate, complain — hands free.",
  "author": "nope-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nope-ai/nope"
  },
  "keywords": [
    "ai",
    "phone",
    "voice",
    "agent",
    "cancel",
    "negotiate",
    "subscription",
    "twilio",
    "openai",
    "open-source"
  ],
  "main": "dist/cli.js",
  "bin": {
    "nope": "dist/cli.js",
    "nope-ai": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "bun run tsc && chmod +x dist/cli.js",
    "dev": "bun run src/cli.ts",
    "start": "bun run dist/cli.js",
    "server": "bun run src/web/server.ts",
    "simulate": "bun run src/cli.ts call --simulate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "openai": "^4.77.0",
    "ora": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "twilio": "^5.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.3.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
