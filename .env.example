# ═══════════════════════════════════════
# NOPE. — Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in your keys.
# Only OPENAI_API_KEY is required to start (simulation mode).
# Add TWILIO keys to make real calls.
#
# Docker:
#   cp .env.example .env
#   docker compose up -d
#   Open http://localhost:4000

# ── OpenAI (Required) ──
OPENAI_API_KEY=sk-...

# ── Twilio (Required for real calls) ──
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Deepgram (Optional — better STT) ──
DEEPGRAM_API_KEY=...

# ── ElevenLabs (Optional — better voice) ──
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ── Anthropic (Optional — use Claude for reasoning) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ──
PORT=4000
HOST=localhost

# ── Mode ──
# Set to "true" to simulate calls without Twilio
SIMULATE=true
