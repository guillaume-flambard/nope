# ═══════════════════════════════════════
# NOPE. — Configuration
# ═══════════════════════════════════════
# Copy this file to .env and fill in your keys.
# Only OPENAI_API_KEY is required to start (simulation mode).
# Add TWILIO keys to make real calls.
#
# Docker:
#   cp .env.example .env
#   docker compose up -d
#   Open http://localhost:4000

# ── OpenAI (Required for live mode without Groq) ──
OPENAI_API_KEY=sk-...

# ── Groq (Optional — free, fast LLM/STT/TTS for live mode; preferred when set) ──
# Free tier: https://console.groq.com/keys (no credit card required)
# Covers LLM (llama), STT (whisper-large-v3) and TTS (orpheus) on one key.
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=diana

# ── Twilio (Required for real calls) ──
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Deepgram (Optional — better STT) ──
DEEPGRAM_API_KEY=...

# ── ElevenLabs (Optional — best-quality TTS; used first when set) ──
# Free tier: 10k credits/month (~10 min). Keys: elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_AGENT_VOICE=jBpfuIE2ffCO9mMExCc1
ELEVENLABS_MODEL=eleven_v3

# ── Anthropic (Optional — use Claude for reasoning) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ──
PORT=4000
HOST=localhost

# ── Mode ──
# Set to "true" to simulate calls without Twilio
SIMULATE=true
